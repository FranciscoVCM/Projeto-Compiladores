  131                | NOT
  132                | LPAR
  133                | RPAR
  134                | LBRACE bad_string_items RBRACE
  135                | LSQ
  136                | RSQ
  137                | SEMICOLON
  138                | COMMA

  139 $@5: ε

  140 invalid_public_decl: PUBLIC $@5 invalid_public_tail

  141 invalid_public_tail: STATIC STRING IDENTIFIER ASSIGN STRLIT semis PUBLIC STATIC VOID invalid_id_list semis
  142                    | STATIC STRING IDENTIFIER ASSIGN STRLIT semis
  143                    | STATIC VOID invalid_id_list semis
  144                    | STATIC method_header method_body
  145                    | STATIC error SEMICOLON
  146                    | error SEMICOLON

  147 invalid_id_list: IDENTIFIER
  148                | invalid_id_list COMMA IDENTIFIER

  149 semis: SEMICOLON
  150      | semis SEMICOLON

  151 var_decl: type var_ids SEMICOLON
  152         | type IDENTIFIER LSQ expr RSQ SEMICOLON
  153         | type var_ids error
  154         | type error SEMICOLON

  155 var_ids: IDENTIFIER
  156        | var_ids COMMA IDENTIFIER

  157 stmt: stmt_entry stmt_core

  158 stmt_entry: ε

  159 stmt_core: LBRACE stmt_list RBRACE
  160          | IF LPAR expr RPAR stmt
  161          | IF LPAR expr RPAR stmt ELSE stmt
  162          | IF LPAR error RPAR stmt
  163          | IF LPAR error RPAR stmt ELSE stmt
  164          | IF LPAR expr error stmt
  165          | IF LPAR expr error stmt ELSE stmt
  166          | WHILE LPAR expr RPAR stmt
  167          | WHILE LPAR error RPAR stmt
  168          | WHILE LPAR expr error stmt
  169          | RETURN expr SEMICOLON
  170          | RETURN SEMICOLON
  171          | RETURN error SEMICOLON
  172          | IDENTIFIER IDENTIFIER RESERVED ASSIGN expr SEMICOLON
  173          | IDENTIFIER ASSIGN expr SEMICOLON
  174          | IDENTIFIER ASSIGN error SEMICOLON
  175          | IDENTIFIER ASSIGN DOTLENGTH IDENTIFIER LPAR expr RPAR SEMICOLON
  176          | PRINT LPAR expr RPAR SEMICOLON
  177          | PRINT LPAR STRLIT RPAR SEMICOLON
  178          | PRINT LPAR error RPAR SEMICOLON
  179          | method_invocation SEMICOLON
  180          | PARSEINT LPAR error RPAR RPAR SEMICOLON
  181          | parse_args SEMICOLON
  182          | SEMICOLON
  183          | error SEMICOLON

  184 stmt_list: ε
  185          | stmt_list stmt

  186 expr: assign_expr

  187 assign_expr: IDENTIFIER ASSIGN assign_expr
  188            | or_expr

  189 or_expr: or_expr OR and_expr
  190        | and_expr

  191 and_expr: and_expr AND xor_expr
  192         | xor_expr

  193 xor_expr: xor_expr XOR eq_expr
  194         | eq_expr

  195 eq_expr: eq_expr EQ rel_expr
  196        | eq_expr NE rel_expr
  197        | rel_expr

  198 rel_expr: rel_expr LT shift_expr
  199         | rel_expr GT shift_expr
  200         | rel_expr LE shift_expr
  201         | rel_expr GE shift_expr
  202         | shift_expr

  203 shift_expr: shift_expr LSHIFT add_expr
  204           | shift_expr RSHIFT add_expr
  205           | add_expr

  206 add_expr: add_expr PLUS mul_expr
  207         | add_expr MINUS mul_expr
  208         | mul_expr

  209 mul_expr: mul_expr STAR unary_expr
  210         | mul_expr DIV unary_expr
  211         | mul_expr MOD unary_expr
  212         | unary_expr

  213 unary_expr: NOT unary_expr
  214           | MINUS unary_expr
  215           | PLUS unary_expr
  216           | primary_expr

  217 primary_expr: IDENTIFIER
  218             | IDENTIFIER DOTLENGTH
  219             | NATURAL
  220             | DECIMAL
  221             | BOOLLIT
  222             | method_invocation
  223             | parse_args
  224             | LPAR expr RPAR
  225             | LPAR error RPAR

  226 method_invocation: IDENTIFIER LPAR args_opt RPAR
  227                  | IDENTIFIER LPAR error RPAR

  228 args_opt: ε
  229         | expr_list

  230 expr_list: expr
  231          | expr_list COMMA expr
  232          | expr_list COMMA error

  233 parse_args: PARSEINT LPAR IDENTIFIER LSQ expr RSQ RPAR
  234           | PARSEINT LPAR expr RPAR
  235           | PARSEINT LPAR error RPAR

  236 type: INT
  237     | DOUBLE
  238     | BOOL


