Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: ε
    3           | class_body field_decl
    4           | class_body method_decl
    5           | class_body SEMICOLON

    6 field_decl: PUBLIC STATIC type field_ids SEMICOLON
    7           | PUBLIC STATIC error SEMICOLON
    8           | PUBLIC STATIC type error SEMICOLON
    9           | error SEMICOLON

   10 field_ids: IDENTIFIER
   11          | field_ids COMMA IDENTIFIER

   12 method_decl: PUBLIC STATIC method_header method_body

   13 $@1: ε

   14 method_decl: PUBLIC STATIC VOID IDENTIFIER LPAR LSQ $@1 RSQ STRING IDENTIFIER RPAR method_body

   15 $@2: ε

   16 method_decl: PUBLIC STATIC type IDENTIFIER LPAR error RPAR $@2 invalid_method_body

   17 $@3: ε

   18 method_decl: PUBLIC STATIC VOID IDENTIFIER LPAR error RPAR $@3 invalid_method_body

   19 method_header: type IDENTIFIER LPAR RPAR
   20              | type IDENTIFIER LPAR param_list RPAR
   21              | VOID IDENTIFIER LPAR RPAR
   22              | VOID IDENTIFIER LPAR param_list RPAR

   23 param_list: param_decl
   24           | param_list COMMA param_decl

   25 param_decl: type IDENTIFIER
   26           | STRING LSQ RSQ IDENTIFIER
   27           | STRING LSQ NATURAL RSQ IDENTIFIER

   28 method_body: LBRACE method_body_items RBRACE

   29 invalid_method_body: LBRACE invalid_body_items RBRACE

   30 invalid_body_items: ε
   31                   | invalid_body_items invalid_body_item

   32 invalid_body_item: LBRACE invalid_body_items RBRACE
   33                  | IDENTIFIER
   34                  | NATURAL
   35                  | DECIMAL
   36                  | STRLIT
   37                  | BOOLLIT
   38                  | CLASS
   39                  | PUBLIC
   40                  | STATIC
   41                  | RESERVED
   42                  | BOOL
   43                  | INT
   44                  | DOUBLE
   45                  | VOID
   46                  | STRING
   47                  | IF
   48                  | ELSE
   49                  | WHILE
   50                  | RETURN
   51                  | PRINT
   52                  | PARSEINT
   53                  | DOTLENGTH
   54                  | INC
   55                  | DEC
   56                  | ARROW
   57                  | ASSIGN
   58                  | PLUS
   59                  | MINUS
   60                  | STAR
   61                  | DIV
   62                  | MOD
   63                  | AND
   64                  | OR
   65                  | XOR
   66                  | LSHIFT
   67                  | RSHIFT
   68                  | EQ
   69                  | NE
   70                  | LT
   71                  | GT
   72                  | LE
   73                  | GE
   74                  | NOT
   75                  | LPAR
   76                  | RPAR
   77                  | LSQ
   78                  | RSQ
   79                  | SEMICOLON
   80                  | COMMA

   81 method_body_items: ε
   82                  | method_body_items invalid_public_decl
   83                  | method_body_items var_decl

   84 $@4: ε

   85 method_body_items: method_body_items STRING $@4 bad_string_tail
   86                  | method_body_items stmt

   87 bad_string_tail: bad_string_items RBRACE

   88 bad_string_items: ε
   89                 | bad_string_items bad_string_item

   90 bad_string_item: IDENTIFIER
   91                | NATURAL
   92                | DECIMAL
   93                | STRLIT
   94                | BOOLLIT
   95                | CLASS
   96                | PUBLIC
   97                | STATIC
   98                | RESERVED
   99                | BOOL
