Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: ε
    3           | class_body field_decl
    4           | class_body method_decl
    5           | class_body SEMICOLON

    6 field_decl: PUBLIC STATIC type field_ids SEMICOLON
    7           | PUBLIC STATIC error SEMICOLON
    8           | PUBLIC STATIC type error SEMICOLON
    9           | error SEMICOLON

   10 field_ids: IDENTIFIER
   11          | field_ids COMMA IDENTIFIER

   12 lbrace_save: LBRACE

   13 method_decl: PUBLIC STATIC method_header method_body

   14 $@1: ε

   15 method_decl: PUBLIC STATIC VOID IDENTIFIER LPAR LSQ $@1 RSQ STRING IDENTIFIER RPAR method_body
   16            | PUBLIC STATIC type IDENTIFIER LPAR param_list lbrace_save method_body_items RBRACE
   17            | PUBLIC STATIC type IDENTIFIER LPAR lbrace_save method_body_items RBRACE
   18            | PUBLIC STATIC VOID IDENTIFIER LPAR param_list lbrace_save method_body_items RBRACE
   19            | PUBLIC STATIC VOID IDENTIFIER LPAR lbrace_save method_body_items RBRACE
   20            | PUBLIC STATIC type IDENTIFIER LPAR error RPAR method_body
   21            | PUBLIC STATIC VOID IDENTIFIER LPAR error RPAR method_body

   22 method_header: type IDENTIFIER LPAR RPAR
   23              | type IDENTIFIER LPAR param_list RPAR
   24              | VOID IDENTIFIER LPAR RPAR
   25              | VOID IDENTIFIER LPAR param_list RPAR

   26 param_list: param_decl
   27           | param_list COMMA param_decl

   28 param_decl: type IDENTIFIER
   29           | STRING LSQ RSQ IDENTIFIER
   30           | STRING LSQ NATURAL RSQ IDENTIFIER

   31 method_body: LBRACE method_body_items RBRACE

   32 method_body_items: ε
   33                  | method_body_items invalid_public_decl
   34                  | method_body_items var_decl
   35                  | method_body_items bad_string_start bad_string_tail
   36                  | method_body_items stmt

   37 bad_string_start: STRING

   38 bad_string_tail: bad_string_items RBRACE

   39 bad_string_items: ε
   40                 | bad_string_items bad_string_item

   41 bad_string_item: IDENTIFIER
   42                | NATURAL
   43                | DECIMAL
   44                | STRLIT
   45                | BOOLLIT
   46                | CLASS
   47                | PUBLIC
   48                | STATIC
   49                | RESERVED
   50                | BOOL
   51                | INT
   52                | DOUBLE
   53                | VOID
   54                | STRING
   55                | IF
   56                | ELSE
   57                | WHILE
   58                | RETURN
   59                | PRINT
   60                | PARSEINT
   61                | DOTLENGTH
   62                | INC
   63                | DEC
   64                | ARROW
   65                | ASSIGN
   66                | PLUS
   67                | MINUS
   68                | STAR
   69                | DIV
   70                | MOD
   71                | AND
   72                | OR
   73                | XOR
   74                | LSHIFT
   75                | RSHIFT
   76                | EQ
   77                | NE
   78                | LT
   79                | GT
   80                | LE
   81                | GE
   82                | NOT
   83                | LPAR
   84                | RPAR
   85                | LBRACE bad_string_items RBRACE
   86                | LSQ
   87                | RSQ
   88                | SEMICOLON
   89                | COMMA

   90 $@2: ε

   91 invalid_public_decl: PUBLIC $@2 invalid_public_tail

   92 invalid_public_tail: STATIC STRING IDENTIFIER ASSIGN STRLIT semis PUBLIC STATIC VOID invalid_id_list semis
   93                    | STATIC STRING IDENTIFIER ASSIGN STRLIT semis
   94                    | STATIC VOID invalid_id_list semis
   95                    | STATIC method_header method_body
   96                    | STATIC error SEMICOLON
   97                    | error SEMICOLON

   98 invalid_id_list: IDENTIFIER
   99                | invalid_id_list COMMA IDENTIFIER

  100 semis: SEMICOLON
  101      | semis SEMICOLON

  102 assign_save: ASSIGN

  103 var_decl: type var_ids SEMICOLON
  104         | type IDENTIFIER LSQ expr RSQ SEMICOLON
  105         | type IDENTIFIER assign_save expr SEMICOLON
  106         | type var_ids error
  107         | type error SEMICOLON

  108 var_ids: IDENTIFIER
  109        | var_ids COMMA IDENTIFIER

  110 stmt: stmt_entry stmt_core

  111 stmt_entry: ε

  112 stmt_core: LBRACE stmt_list RBRACE
  113          | IF LPAR expr RPAR stmt
  114          | IF LPAR expr RPAR stmt ELSE stmt
  115          | IF LPAR error RPAR stmt
  116          | IF LPAR error RPAR stmt ELSE stmt
  117          | IF LPAR expr RETURN expr SEMICOLON
  118          | IF LPAR expr RETURN SEMICOLON
  119          | IF LPAR expr error stmt
  120          | IF LPAR expr error stmt ELSE stmt
  121          | WHILE LPAR expr RPAR stmt
  122          | WHILE LPAR error RPAR stmt
  123          | WHILE LPAR expr error stmt
  124          | RETURN expr SEMICOLON
  125          | RETURN SEMICOLON
  126          | RETURN error SEMICOLON
  127          | IDENTIFIER IDENTIFIER RESERVED ASSIGN expr SEMICOLON
  128          | IDENTIFIER ASSIGN PARSEINT LPAR expr RPAR SEMICOLON
  129          | IDENTIFIER ASSIGN expr SEMICOLON
  130          | IDENTIFIER ASSIGN error SEMICOLON
  131          | IDENTIFIER ASSIGN DOTLENGTH IDENTIFIER LPAR expr RPAR SEMICOLON
  132          | PRINT LPAR expr RPAR SEMICOLON
  133          | PRINT LPAR STRLIT RPAR SEMICOLON
  134          | PRINT LPAR error RPAR SEMICOLON
  135          | method_invocation SEMICOLON
  136          | PARSEINT LPAR error RPAR RPAR SEMICOLON
  137          | parse_args SEMICOLON
  138          | SEMICOLON
  139          | error SEMICOLON

  140 stmt_list: ε
  141          | stmt_list stmt

  142 expr: assign_expr

  143 assign_expr: IDENTIFIER ASSIGN assign_expr
  144            | or_expr

  145 or_expr: or_expr OR and_expr
  146        | and_expr

  147 and_expr: and_expr AND xor_expr
  148         | xor_expr

  149 xor_expr: xor_expr XOR eq_expr
  150         | eq_expr

  151 eq_expr: eq_expr EQ rel_expr
  152        | eq_expr NE rel_expr
  153        | rel_expr

  154 rel_expr: rel_expr LT shift_expr
  155         | rel_expr GT shift_expr
  156         | rel_expr LE shift_expr
  157         | rel_expr GE shift_expr
  158         | shift_expr

  159 shift_expr: shift_expr LSHIFT add_expr
  160           | shift_expr RSHIFT add_expr
  161           | add_expr

  162 add_expr: add_expr PLUS mul_expr
  163         | add_expr MINUS mul_expr
  164         | mul_expr

  165 mul_expr: mul_expr STAR unary_expr
  166         | mul_expr DIV unary_expr
  167         | mul_expr MOD unary_expr
  168         | unary_expr

  169 unary_expr: NOT unary_expr
  170           | MINUS unary_expr
  171           | PLUS unary_expr
  172           | primary_expr

  173 primary_expr: IDENTIFIER
  174             | IDENTIFIER DOTLENGTH
  175             | NATURAL
  176             | DECIMAL
  177             | BOOLLIT
  178             | method_invocation
  179             | parse_args
  180             | LPAR expr RPAR
  181             | LPAR error RPAR

  182 method_invocation: IDENTIFIER LPAR args_opt RPAR
  183                  | IDENTIFIER LPAR error RPAR

  184 args_opt: ε
  185         | expr_list

  186 expr_list: expr
  187          | expr_list COMMA expr
  188          | expr_list COMMA error

  189 parse_args: PARSEINT LPAR IDENTIFIER LSQ expr RSQ RPAR
  190           | PARSEINT LPAR error RPAR

  191 type: INT
  192     | DOUBLE
  193     | BOOL


