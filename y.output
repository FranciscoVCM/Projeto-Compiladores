Terminals unused in grammar

    ARROW
    RESERVED


Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: class_body method_decl
    3           | class_body field_decl
    4           | class_body SEMICOLON
    5           | ε

    6 field_decl: PUBLIC STATIC type IDENTIFIER field_tail SEMICOLON
    7           | error SEMICOLON

    8 field_tail: COMMA IDENTIFIER field_tail
    9           | ε

   10 type: BOOL
   11     | INT
   12     | DOUBLE

   13 method_decl: PUBLIC STATIC method_header method_body

   14 method_header: type IDENTIFIER LPAR params_opt RPAR
   15              | VOID IDENTIFIER LPAR params_opt RPAR

   16 params_opt: type IDENTIFIER params_tail
   17           | STRING LSQ RSQ IDENTIFIER
   18           | ε

   19 params_tail: COMMA type IDENTIFIER params_tail
   20            | ε

   21 method_body: LBRACE body_items RBRACE

   22 body_items: var_decl body_items
   23           | stmt body_items
   24           | ε

   25 var_decl: type IDENTIFIER var_tail SEMICOLON

   26 var_tail: COMMA IDENTIFIER var_tail
   27         | ε

   28 stmt: LBRACE stmt_list RBRACE
   29     | IF LPAR full_expr RPAR stmt
   30     | IF LPAR full_expr RPAR stmt ELSE stmt
   31     | WHILE LPAR full_expr RPAR stmt
   32     | RETURN full_expr SEMICOLON
   33     | RETURN SEMICOLON
   34     | SEMICOLON
   35     | method_call SEMICOLON
   36     | assignment SEMICOLON
   37     | parse_args SEMICOLON
   38     | PRINT LPAR full_expr RPAR SEMICOLON
   39     | PRINT LPAR STRLIT RPAR SEMICOLON
   40     | error SEMICOLON

   41 stmt_list: stmt stmt_list
   42          | ε

   43 method_call: IDENTIFIER LPAR full_expr arg_tail RPAR
   44            | IDENTIFIER LPAR error RPAR
   45            | IDENTIFIER LPAR RPAR

   46 arg_tail: arg_tail COMMA full_expr
   47         | ε

   48 assignment: IDENTIFIER ASSIGN full_expr

   49 parse_args: PARSEINT LPAR IDENTIFIER LSQ full_expr RSQ RPAR
   50           | PARSEINT LPAR error RPAR

   51 full_expr: expr
   52          | assignment

   53 expr: expr PLUS expr
   54     | expr MINUS expr
   55     | expr STAR expr
   56     | expr DIV expr
   57     | expr MOD expr
   58     | expr EQ expr
   59     | expr NE expr
   60     | expr LT expr
   61     | expr GT expr
   62     | expr LE expr
   63     | expr GE expr
   64     | expr OR expr
   65     | expr XOR expr
   66     | expr AND expr
   67     | expr LSHIFT expr
   68     | expr RSHIFT expr
   69     | MINUS expr
   70     | PLUS expr
   71     | NOT expr
   72     | LPAR full_expr RPAR
   73     | method_call
   74     | parse_args
   75     | IDENTIFIER
   76     | IDENTIFIER DOTLENGTH
   77     | NATURAL
   78     | DECIMAL
   79     | BOOLLIT
   80     | LPAR error RPAR


