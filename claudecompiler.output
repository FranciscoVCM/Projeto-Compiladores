Terminals unused in grammar

    RESERVED
    INC
    DEC
    ARROW


Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: ε
    3           | class_body class_member

    4 class_member: field_decl
    5             | method_decl
    6             | SEMICOLON
    7             | error SEMICOLON

    8 field_decl: PUBLIC STATIC type field_ids SEMICOLON
    9           | PUBLIC STATIC error SEMICOLON

   10 field_ids: IDENTIFIER
   11          | field_ids COMMA IDENTIFIER

   12 method_decl: PUBLIC STATIC method_header method_body
   13            | PUBLIC STATIC method_header error SEMICOLON

   14 method_header: type IDENTIFIER LPAR RPAR
   15              | type IDENTIFIER LPAR formal_params RPAR
   16              | VOID IDENTIFIER LPAR RPAR
   17              | VOID IDENTIFIER LPAR formal_params RPAR

   18 formal_params: formal_param
   19              | STRING LSQ RSQ IDENTIFIER
   20              | STRING LSQ NATURAL RSQ IDENTIFIER
   21              | formal_params COMMA formal_param

   22 formal_param: type IDENTIFIER

   23 method_body: LBRACE method_body_items RBRACE

   24 method_body_items: ε
   25                  | method_body_items var_decl
   26                  | method_body_items stmt

   27 var_decl: type var_ids SEMICOLON
   28         | type error SEMICOLON

   29 var_ids: IDENTIFIER
   30        | var_ids COMMA IDENTIFIER

   31 stmt: LBRACE stmt_list RBRACE
   32     | IF LPAR expr RPAR stmt
   33     | IF LPAR expr RPAR stmt ELSE stmt
   34     | IF LPAR error RPAR stmt
   35     | IF LPAR error RPAR stmt ELSE stmt
   36     | IF LPAR expr error stmt
   37     | IF LPAR expr error stmt ELSE stmt
   38     | WHILE LPAR expr RPAR stmt
   39     | WHILE LPAR error RPAR stmt
   40     | RETURN expr SEMICOLON
   41     | RETURN SEMICOLON
   42     | RETURN error SEMICOLON
   43     | method_invocation SEMICOLON
   44     | IDENTIFIER ASSIGN expr SEMICOLON
   45     | parse_args SEMICOLON
   46     | PRINT LPAR expr RPAR SEMICOLON
   47     | PRINT LPAR STRLIT RPAR SEMICOLON
   48     | PRINT LPAR error RPAR SEMICOLON
   49     | SEMICOLON
   50     | error SEMICOLON

   51 stmt_list: ε
   52          | stmt_list stmt

   53 expr: assignment_expr

   54 assignment_expr: IDENTIFIER ASSIGN assignment_expr
   55                | or_expr

   56 or_expr: or_expr OR and_expr
   57        | and_expr

   58 and_expr: and_expr AND xor_expr
   59         | xor_expr

   60 xor_expr: xor_expr XOR equality_expr
   61         | equality_expr

   62 equality_expr: equality_expr EQ relational_expr
   63              | equality_expr NE relational_expr
   64              | relational_expr

   65 relational_expr: relational_expr LT shift_expr
   66                | relational_expr GT shift_expr
   67                | relational_expr LE shift_expr
   68                | relational_expr GE shift_expr
   69                | shift_expr

   70 shift_expr: shift_expr LSHIFT additive_expr
   71           | shift_expr RSHIFT additive_expr
   72           | additive_expr

   73 additive_expr: additive_expr PLUS multiplicative_expr
   74              | additive_expr MINUS multiplicative_expr
   75              | multiplicative_expr

   76 multiplicative_expr: multiplicative_expr STAR unary_expr
   77                    | multiplicative_expr DIV unary_expr
   78                    | multiplicative_expr MOD unary_expr
   79                    | unary_expr

   80 unary_expr: NOT unary_expr
   81           | MINUS unary_expr
   82           | PLUS unary_expr
   83           | primary_expr

   84 primary_expr: IDENTIFIER
   85             | IDENTIFIER DOTLENGTH
   86             | NATURAL
   87             | DECIMAL
   88             | BOOLLIT
   89             | method_invocation
   90             | parse_args
   91             | LPAR expr RPAR
   92             | LPAR error RPAR

   93 method_invocation: IDENTIFIER LPAR args_opt RPAR
   94                  | IDENTIFIER LPAR error RPAR

   95 args_opt: ε
   96         | expr_list

   97 expr_list: expr
   98          | expr_list COMMA expr
   99          | expr_list COMMA error

  100 parse_args: PARSEINT LPAR IDENTIFIER LSQ expr RSQ RPAR
  101           | PARSEINT LPAR error RPAR

  102 type: BOOL
  103     | INT
  104     | DOUBLE


