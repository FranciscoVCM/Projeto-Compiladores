Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: ε
    3           | class_body field_decl
    4           | class_body method_decl
    5           | class_body SEMICOLON

    6 field_decl: PUBLIC STATIC type field_ids SEMICOLON
    7           | PUBLIC STATIC error SEMICOLON
    8           | PUBLIC STATIC type error SEMICOLON
    9           | error SEMICOLON

   10 field_ids: IDENTIFIER
   11          | field_ids COMMA IDENTIFIER

   12 method_decl: PUBLIC STATIC method_header method_body

   13 $@1: ε

   14 method_decl: PUBLIC STATIC VOID IDENTIFIER LPAR LSQ $@1 RSQ STRING IDENTIFIER RPAR method_body

   15 $@2: ε

   16 method_decl: PUBLIC STATIC type IDENTIFIER LPAR error RPAR $@2 invalid_method_body

   17 $@3: ε

   18 method_decl: PUBLIC STATIC VOID IDENTIFIER LPAR error RPAR $@3 invalid_method_body

   19 method_header: type IDENTIFIER LPAR RPAR
   20              | type IDENTIFIER LPAR param_list RPAR
   21              | VOID IDENTIFIER LPAR RPAR
   22              | VOID IDENTIFIER LPAR param_list RPAR

   23 param_list: param_decl
   24           | param_list COMMA param_decl

   25 param_decl: type IDENTIFIER
   26           | STRING LSQ RSQ IDENTIFIER
   27           | STRING LSQ NATURAL RSQ IDENTIFIER

   28 method_body: LBRACE method_body_items RBRACE

   29 invalid_method_body: LBRACE invalid_body_items RBRACE

   30 invalid_body_items: ε
   31                   | invalid_body_items invalid_body_item

   32 invalid_body_item: LBRACE invalid_body_items RBRACE
   33                  | IDENTIFIER
   34                  | NATURAL
   35                  | DECIMAL
   36                  | STRLIT
   37                  | BOOLLIT
   38                  | CLASS
   39                  | PUBLIC
   40                  | STATIC
   41                  | RESERVED
   42                  | BOOL
   43                  | INT
   44                  | DOUBLE
   45                  | VOID
   46                  | STRING
   47                  | IF
   48                  | ELSE
   49                  | WHILE
   50                  | RETURN
   51                  | PRINT
   52                  | PARSEINT
   53                  | DOTLENGTH
   54                  | INC
   55                  | DEC
   56                  | ARROW
   57                  | ASSIGN
   58                  | PLUS
   59                  | MINUS
   60                  | STAR
   61                  | DIV
   62                  | MOD
   63                  | AND
   64                  | OR
   65                  | XOR
   66                  | LSHIFT
   67                  | RSHIFT
   68                  | EQ
   69                  | NE
   70                  | LT
   71                  | GT
   72                  | LE
   73                  | GE
   74                  | NOT
   75                  | LPAR
   76                  | RPAR
   77                  | LSQ
   78                  | RSQ
   79                  | SEMICOLON
   80                  | COMMA

   81 method_body_items: ε
   82                  | method_body_items invalid_public_decl
   83                  | method_body_items var_decl
   84                  | method_body_items bad_string_start bad_string_tail
   85                  | method_body_items stmt

   86 bad_string_start: STRING

   87 bad_string_tail: bad_string_items RBRACE

   88 bad_string_items: ε
   89                 | bad_string_items bad_string_item

   90 bad_string_item: IDENTIFIER
   91                | NATURAL
   92                | DECIMAL
   93                | STRLIT
   94                | BOOLLIT
   95                | CLASS
   96                | PUBLIC
   97                | STATIC
   98                | RESERVED
   99                | BOOL
  100                | INT
  101                | DOUBLE
  102                | VOID
  103                | STRING
  104                | IF
  105                | ELSE
  106                | WHILE
  107                | RETURN
  108                | PRINT
  109                | PARSEINT
  110                | DOTLENGTH
  111                | INC
  112                | DEC
  113                | ARROW
  114                | ASSIGN
  115                | PLUS
  116                | MINUS
  117                | STAR
  118                | DIV
  119                | MOD
  120                | AND
  121                | OR
  122                | XOR
  123                | LSHIFT
  124                | RSHIFT
  125                | EQ
  126                | NE
  127                | LT
  128                | GT
  129                | LE
  130                | GE
  131                | NOT
  132                | LPAR
  133                | RPAR
  134                | LBRACE bad_string_items RBRACE
  135                | LSQ
  136                | RSQ
  137                | SEMICOLON
  138                | COMMA

  139 $@4: ε

  140 invalid_public_decl: PUBLIC $@4 invalid_public_tail

  141 invalid_public_tail: STATIC STRING IDENTIFIER ASSIGN STRLIT semis PUBLIC STATIC VOID invalid_id_list semis
  142                    | STATIC STRING IDENTIFIER ASSIGN STRLIT semis
  143                    | STATIC VOID invalid_id_list semis
  144                    | STATIC method_header method_body
  145                    | STATIC error SEMICOLON
  146                    | error SEMICOLON

  147 invalid_id_list: IDENTIFIER
  148                | invalid_id_list COMMA IDENTIFIER

  149 semis: SEMICOLON
  150      | semis SEMICOLON

  151 assign_save: ASSIGN

  152 var_decl: type var_ids SEMICOLON
  153         | type IDENTIFIER LSQ expr RSQ SEMICOLON
  154         | type IDENTIFIER assign_save expr SEMICOLON
  155         | type var_ids error
  156         | type error SEMICOLON

  157 var_ids: IDENTIFIER
  158        | var_ids COMMA IDENTIFIER

  159 stmt: stmt_entry stmt_core

  160 stmt_entry: ε

  161 stmt_core: LBRACE stmt_list RBRACE
  162          | IF LPAR expr RPAR stmt
  163          | IF LPAR expr RPAR stmt ELSE stmt
  164          | IF LPAR error RPAR stmt
  165          | IF LPAR error RPAR stmt ELSE stmt
  166          | IF LPAR expr error stmt
  167          | IF LPAR expr error stmt ELSE stmt
  168          | WHILE LPAR expr RPAR stmt
  169          | WHILE LPAR error RPAR stmt
  170          | WHILE LPAR expr error stmt
  171          | RETURN expr SEMICOLON
  172          | RETURN SEMICOLON
  173          | RETURN error SEMICOLON
  174          | IDENTIFIER IDENTIFIER RESERVED ASSIGN expr SEMICOLON
  175          | IDENTIFIER ASSIGN PARSEINT LPAR expr RPAR SEMICOLON
  176          | IDENTIFIER ASSIGN expr SEMICOLON
  177          | IDENTIFIER ASSIGN error SEMICOLON
  178          | IDENTIFIER ASSIGN DOTLENGTH IDENTIFIER LPAR expr RPAR SEMICOLON
  179          | PRINT LPAR expr RPAR SEMICOLON
  180          | PRINT LPAR STRLIT RPAR SEMICOLON
  181          | PRINT LPAR error RPAR SEMICOLON
  182          | method_invocation SEMICOLON
  183          | PARSEINT LPAR error RPAR RPAR SEMICOLON
  184          | parse_args SEMICOLON
  185          | SEMICOLON
  186          | error SEMICOLON

  187 stmt_list: ε
  188          | stmt_list stmt

  189 expr: assign_expr

  190 assign_expr: IDENTIFIER ASSIGN assign_expr
  191            | or_expr

  192 or_expr: or_expr OR and_expr
  193        | and_expr

  194 and_expr: and_expr AND xor_expr
  195         | xor_expr

  196 xor_expr: xor_expr XOR eq_expr
  197         | eq_expr

  198 eq_expr: eq_expr EQ rel_expr
  199        | eq_expr NE rel_expr
  200        | rel_expr

  201 rel_expr: rel_expr LT shift_expr
  202         | rel_expr GT shift_expr
  203         | rel_expr LE shift_expr
  204         | rel_expr GE shift_expr
  205         | shift_expr

  206 shift_expr: shift_expr LSHIFT add_expr
  207           | shift_expr RSHIFT add_expr
  208           | add_expr

  209 add_expr: add_expr PLUS mul_expr
  210         | add_expr MINUS mul_expr
  211         | mul_expr

  212 mul_expr: mul_expr STAR unary_expr
  213         | mul_expr DIV unary_expr
  214         | mul_expr MOD unary_expr
  215         | unary_expr

  216 unary_expr: NOT unary_expr
  217           | MINUS unary_expr
  218           | PLUS unary_expr
  219           | primary_expr

  220 primary_expr: IDENTIFIER
  221             | IDENTIFIER DOTLENGTH
  222             | NATURAL
  223             | DECIMAL
  224             | BOOLLIT
  225             | method_invocation
  226             | parse_args
  227             | LPAR expr RPAR
  228             | LPAR error RPAR

  229 method_invocation: IDENTIFIER LPAR args_opt RPAR
  230                  | IDENTIFIER LPAR error RPAR

  231 args_opt: ε
  232         | expr_list

  233 expr_list: expr
  234          | expr_list COMMA expr
  235          | expr_list COMMA error

  236 parse_args: PARSEINT LPAR IDENTIFIER LSQ expr RSQ RPAR
  237           | PARSEINT LPAR error RPAR

  238 type: INT
  239     | DOUBLE
  240     | BOOL


