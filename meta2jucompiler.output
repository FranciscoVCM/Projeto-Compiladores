Terminals unused in grammar

    INC
    DEC
    ARROW


Grammar

    0 $accept: program $end

    1 program: CLASS IDENTIFIER LBRACE class_body RBRACE

    2 class_body: ε
    3           | class_body class_member

    4 class_member: field_decl
    5             | method_decl
    6             | SEMICOLON
    7             | error SEMICOLON

    8 field_decl: PUBLIC STATIC type field_ids SEMICOLON
    9           | PUBLIC STATIC error SEMICOLON

   10 field_ids: IDENTIFIER
   11          | field_ids COMMA IDENTIFIER

   12 method_decl: PUBLIC STATIC method_header method_body
   13            | PUBLIC STATIC method_header error SEMICOLON

   14 method_header: type IDENTIFIER LPAR RPAR
   15              | type IDENTIFIER LPAR formal_params RPAR
   16              | VOID IDENTIFIER LPAR RPAR
   17              | VOID IDENTIFIER LPAR formal_params RPAR

   18 formal_params: formal_param
   19              | STRING LSQ RSQ IDENTIFIER
   20              | STRING LSQ NATURAL RSQ IDENTIFIER
   21              | formal_params COMMA formal_param

   22 formal_param: type IDENTIFIER

   23 method_body: LBRACE method_body_items RBRACE

   24 method_body_items: ε
   25                  | method_body_items var_decl
   26                  | method_body_items stmt

   27 var_decl: type var_ids SEMICOLON
   28         | type var_ids error
   29         | type error SEMICOLON

   30 var_ids: IDENTIFIER
   31        | var_ids COMMA IDENTIFIER

   32 stmt: LBRACE stmt_list RBRACE
   33     | IF LPAR expr RPAR stmt
   34     | IF LPAR expr RPAR stmt ELSE stmt
   35     | IF LPAR error RPAR stmt
   36     | IF LPAR error RPAR stmt ELSE stmt
   37     | IF LPAR expr error stmt
   38     | IF LPAR expr error stmt ELSE stmt
   39     | WHILE LPAR expr RPAR stmt
   40     | WHILE LPAR error RPAR stmt
   41     | WHILE LPAR expr error stmt
   42     | RETURN expr SEMICOLON
   43     | RETURN SEMICOLON
   44     | RETURN error SEMICOLON
   45     | method_invocation SEMICOLON
   46     | method_invocation error
   47     | IDENTIFIER ASSIGN expr SEMICOLON
   48     | IDENTIFIER ASSIGN error SEMICOLON
   49     | parse_args SEMICOLON
   50     | PRINT LPAR expr RPAR SEMICOLON
   51     | PRINT LPAR STRLIT RPAR SEMICOLON
   52     | PRINT LPAR error RPAR SEMICOLON
   53     | RESERVED error SEMICOLON
   54     | SEMICOLON
   55     | error SEMICOLON

   56 stmt_list: ε
   57          | stmt_list stmt

   58 expr: assignment_expr

   59 assignment_expr: IDENTIFIER ASSIGN assignment_expr
   60                | or_expr

   61 or_expr: or_expr OR and_expr
   62        | and_expr

   63 and_expr: and_expr AND xor_expr
   64         | xor_expr

   65 xor_expr: xor_expr XOR equality_expr
   66         | equality_expr

   67 equality_expr: equality_expr EQ relational_expr
   68              | equality_expr NE relational_expr
   69              | relational_expr

   70 relational_expr: relational_expr LT shift_expr
   71                | relational_expr GT shift_expr
   72                | relational_expr LE shift_expr
   73                | relational_expr GE shift_expr
   74                | shift_expr

   75 shift_expr: shift_expr LSHIFT additive_expr
   76           | shift_expr RSHIFT additive_expr
   77           | additive_expr

   78 additive_expr: additive_expr PLUS multiplicative_expr
   79              | additive_expr MINUS multiplicative_expr
   80              | multiplicative_expr

   81 multiplicative_expr: multiplicative_expr STAR unary_expr
   82                    | multiplicative_expr DIV unary_expr
   83                    | multiplicative_expr MOD unary_expr
   84                    | unary_expr

   85 unary_expr: NOT unary_expr
   86           | MINUS unary_expr
   87           | PLUS unary_expr
   88           | primary_expr

   89 primary_expr: IDENTIFIER
   90             | IDENTIFIER DOTLENGTH
   91             | NATURAL
   92             | DECIMAL
   93             | BOOLLIT
   94             | method_invocation
   95             | parse_args
   96             | LPAR expr RPAR
   97             | LPAR error RPAR

   98 method_invocation: IDENTIFIER LPAR args_opt RPAR
   99                  | IDENTIFIER LPAR error RPAR

  100 args_opt: ε
  101         | expr_list

  102 expr_list: expr
  103          | expr_list COMMA expr
  104          | expr_list COMMA error

  105 parse_args: PARSEINT LPAR IDENTIFIER LSQ expr RSQ RPAR
  106           | PARSEINT LPAR error RPAR

  107 type: BOOL
  108     | INT
  109     | DOUBLE


